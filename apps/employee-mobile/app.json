{
  "expo": {
    "name": "Perzent Field Employee",
    "slug": "perzent-employee",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Perzent uses your location to stamp shift check-in and check-out coordinates."
      }
    },
    "android": {
      "package": "app.jspcoders.perzent",
      "versionCode": 3,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
