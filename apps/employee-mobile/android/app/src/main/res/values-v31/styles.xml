<resources>
  <!-- Android 12+ system splash: Perzent mark in the centre, "Developed by JSP Coders" branding at the bottom. -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    <item name="android:windowBackground">@drawable/ic_launcher_background</item>
  </style>
</resources>
