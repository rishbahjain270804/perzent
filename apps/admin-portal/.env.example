# --- Database (Supabase Postgres) ---
# Runtime: transaction pooler. Migrations: session pooler / direct connection.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Scheduled maintenance (auto check-out, break limits, retention) ---
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to /api/cron/policies. Generate: openssl rand -hex 32
CRON_SECRET=change-me

# --- Mobile app distribution ---
# Optional overrides; defaults come from src/lib/app-version.ts
# LATEST_APP_VERSION=1.2.0
# LATEST_APP_VERSION_CODE=12
# MIN_APP_VERSION_CODE=11
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.jspcoders.perzent
# EMPLOYEE_APK_URL=https://your-cdn.example/perzent-employee-latest.apk

# --- CORS allow-list for browser clients (the deployment's own origin is always allowed) ---
# NEXT_PUBLIC_EMPLOYEE_APP_URL=https://app.example.com
# NEXT_PUBLIC_OWNER_ADMIN_URL=https://admin.example.com

# --- Cashfree (only needed if the paid tier is enabled; the launch plan is free) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ALLOW_MOCK=false
