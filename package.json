{
  "name": "perzent",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @perzent/database generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @perzent/database generate",
    "db:push": "pnpm --filter @perzent/database push",
    "db:migrate": "pnpm --filter @perzent/database migrate:deploy",
    "db:migrate:status": "pnpm --filter @perzent/database migrate:status",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "next": "^15.5.23",
    "prettier": "^3.5.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.10",
      "@types/react-dom": "^19.0.4"
    }
  },
  "packageManager": "pnpm@10.14.0"
}
