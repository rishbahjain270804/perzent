generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum ShiftStatus {
  CHECKED_IN
  ON_BREAK
  CHECKED_OUT
  AUTO_CHECKED_OUT
}

enum PunchBy {
  EMPLOYEE
  MANAGER
  OWNER
  AUTO_SYSTEM
}

enum BreakType {
  LUNCH
  TEA
  GENERAL
}

enum BreakEndedBy {
  EMPLOYEE
  AUTO_TIMEOUT_30MIN
  MANAGER
}

enum TamperEventType {
  GPS_DISABLED
  PERMISSION_REVOKED
  MOCK_LOCATION_DETECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Company {
  id                         String         @id @default(uuid())
  name                       String
  owner_email                String         @unique
  timezone                   String         @default("Asia/Kolkata")
  auto_checkout_time         String         @default("23:40")
  max_break_minutes          Int            @default(30)
  route_retention_days       Int            @default(15)
  attendance_retention_days  Int            @default(45)
  plan_tier                  String         @default("FREE")
  created_at                 DateTime       @default(now())
  updated_at                 DateTime       @updatedAt

  users                      User[]
  departments                Department[]
  payments                   PaymentTransaction[]
}

model Department {
  id          String   @id @default(uuid())
  company_id  String
  name        String
  created_at  DateTime @default(now())

  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users       User[]
  payment_transactions PaymentTransaction[]

  @@unique([company_id, name])
}

model User {
  id            String       @id @default(uuid())
  company_id    String
  department_id String?
  manager_id    String?
  full_name     String
  email         String?
  phone         String
  password_hash String
  role          Role         @default(EMPLOYEE)
  designation   String
  status        UserStatus   @default(ACTIVE)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  company       Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [department_id], references: [id], onDelete: SetNull)
  manager       User?        @relation("ManagerSubordinates", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates  User[]       @relation("ManagerSubordinates")
  devices       UserDevice[]
  attendances   AttendanceRecord[]
  stops         LocationStop[]
  waypoints     LocationWaypoint[]
  tamper_logs   TamperLog[]
  sessions      Session[]
  managed_payment_orders PaymentTransaction[] @relation("PaymentManager")
  provisioned_payments   PaymentTransaction[] @relation("ProvisionedUser")

  @@unique([company_id, phone])
  @@unique([company_id, email])
  @@index([company_id, role, status])
  @@index([manager_id])
}

model UserDevice {
  id             String    @id @default(uuid())
  user_id        String
  device_uuid    String
  device_model   String?
  os_version     String?
  fcm_token      String?
  is_active      Boolean   @default(true)
  last_seen_at   DateTime  @default(now())
  created_at     DateTime  @default(now())
  telemetry      Json?

  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_uuid])
  @@index([user_id, is_active])
}

model AttendanceRecord {
  id                       String       @id @default(uuid())
  user_id                  String
  work_date                DateTime     @db.Date
  punch_in_time            DateTime
  punch_out_time           DateTime?
  punch_in_by              PunchBy      @default(EMPLOYEE)
  punch_out_by             PunchBy?
  punch_out_override_time  DateTime?
  override_reason          String?
  punch_in_lat             Float?
  punch_in_lng             Float?
  punch_out_lat            Float?
  punch_out_lng            Float?
  status                   ShiftStatus  @default(CHECKED_IN)
  gross_worked_minutes     Int          @default(0)
  total_break_minutes      Int          @default(0)
  net_worked_minutes       Int          @default(0)
  created_at               DateTime     @default(now())
  updated_at               DateTime     @updatedAt

  user                     User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  breaks                   AttendanceBreak[]
  stops                    LocationStop[]
  waypoints                LocationWaypoint[]
  tamper_logs              TamperLog[]

  @@unique([user_id, work_date])
  @@index([work_date, status])
}

model AttendanceBreak {
  id                String         @id @default(uuid())
  attendance_id     String
  break_type        BreakType      @default(LUNCH)
  start_time        DateTime       @default(now())
  end_time          DateTime?
  duration_minutes  Int            @default(0)
  ended_by          BreakEndedBy?
  created_at        DateTime       @default(now())

  attendance        AttendanceRecord @relation(fields: [attendance_id], references: [id], onDelete: Cascade)

  @@index([attendance_id, start_time])
}

model LocationStop {
  id                      String            @id @default(uuid())
  attendance_id           String
  user_id                 String
  latitude                Float
  longitude               Float
  address_name            String?
  start_time              DateTime
  end_time                DateTime
  dwell_duration_seconds  Int
  created_at              DateTime          @default(now())

  attendance              AttendanceRecord  @relation(fields: [attendance_id], references: [id], onDelete: Cascade)
  user                    User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, start_time])
  @@index([attendance_id])
}

model LocationWaypoint {
  id             String            @id @default(uuid())
  attendance_id  String
  user_id        String
  latitude       Float
  longitude      Float
  speed          Float             @default(0)
  heading        Float             @default(0)
  accuracy       Float
  recorded_at    DateTime          @default(now())

  attendance     AttendanceRecord  @relation(fields: [attendance_id], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, recorded_at])
  @@index([attendance_id, recorded_at])
}

model TamperLog {
  id             String            @id @default(uuid())
  attendance_id  String?
  user_id        String
  event_type     TamperEventType
  details        String?
  occurred_at    DateTime          @default(now())

  attendance     AttendanceRecord? @relation(fields: [attendance_id], references: [id], onDelete: SetNull)
  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, occurred_at])
}

model PaymentTransaction {
  id                     String        @id @default(uuid())
  company_id             String
  order_id               String        @unique
  cashfree_order_id       String?
  payment_session_id      String?
  employee_name          String
  employee_phone         String
  employee_email         String?
  employee_password_hash String?
  employee_designation   String
  employee_role          Role          @default(EMPLOYEE)
  employee_department_id String?
  employee_manager_id    String?
  provisioned_user_id    String?
  base_price             Decimal       @db.Decimal(10, 2)
  tax_amount             Decimal       @db.Decimal(10, 2)
  total_amount           Decimal       @db.Decimal(10, 2)
  currency               String        @default("INR")
  status                 PaymentStatus @default(PENDING)
  payment_method         String?
  bank_reference         String?
  invoice_number         String?       @unique
  created_at             DateTime      @default(now())
  paid_at                DateTime?
  updated_at             DateTime      @updatedAt

  company                Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee_department    Department?    @relation(fields: [employee_department_id], references: [id], onDelete: SetNull)
  employee_manager       User?          @relation("PaymentManager", fields: [employee_manager_id], references: [id], onDelete: SetNull)
  provisioned_user       User?          @relation("ProvisionedUser", fields: [provisioned_user_id], references: [id], onDelete: SetNull)

  @@index([company_id, status, created_at])
  @@index([employee_department_id])
  @@index([employee_manager_id])
}

model Session {
  id          String   @id @default(uuid())
  token_hash  String   @unique
  user_id     String
  expires_at  DateTime
  created_at  DateTime @default(now())
  last_seen_at DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}
